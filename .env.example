# ─────────────────────────────────────────────────────────────────────────────
# Visadin AI – Environment Configuration
# Copy this file to .env and edit the values below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Camera Streams ────────────────────────────────────────────────────────────
# Comma-separated camera sources: can be integer USB indices ("0", "1") or RTSP/HTTP URLs
CAMERA_SOURCES=0,rtsp://wowzaec2demo.streamlock.net/vod/mp4:BigBuckBunny_115k.mov

# Backward-compat alias for RTSP URLs
RTSP_URLS=rtsp://wowzaec2demo.streamlock.net/vod/mp4:BigBuckBunny_115k.mov

# Optional: Custom GStreamer pipeline template ({url} will be substituted)
# GST_PIPELINE=rtspsrc location={url} latency=80 protocols=tcp ! rtph264depay ! h264parse ! avdec_h264 ! videoconvert ! appsink max-buffers=1 drop=true

# Force OpenCV (FFMPEG) backend even when GStreamer is available
FORCE_OPENCV_BACKEND=false

# Seconds to wait before reconnecting after a stream drop
RECONNECT_DELAY_S=3.0

# Size of the in-memory frame ring buffer per camera
FRAME_BUFFER_SIZE=30

# ── FPS Throttling / Storage ──────────────────────────────────────────────────
IDLE_FPS=5
ACTIVE_FPS=30

# MOG2 foreground-pixel count to trigger ACTIVE state
MOTION_PIXEL_THRESHOLD=1500

# Seconds of inactivity before reverting to IDLE
IDLE_TIMEOUT_S=10.0

# Pre-event ring buffer length in seconds
PRE_EVENT_BUFFER_S=5.0

# Directory where video chunks are written
STORAGE_DIR=recordings

# How long each MP4 chunk is (seconds) before a new file is opened
CHUNK_DURATION_S=60

# Video codec (FourCC)
ACTIVE_CODEC=mp4v
IDLE_CODEC=mp4v

# Quality (unused by raw mp4v; hook for future FFmpeg integration)
ACTIVE_QUALITY=18
IDLE_QUALITY=28

# ── AI Detector ───────────────────────────────────────────────────────────────
# Path to the YOLO weights file (will be auto-downloaded on first run)
YOLO_MODEL_PATH=yolov8n.pt

# "auto" | "cpu" | "cuda" | "mps" | "openvino" | "tensorrt"
YOLO_DEVICE=auto

# Detection confidence threshold (0.0 – 1.0)
YOLO_CONF=0.45

# NMS IoU threshold
YOLO_IOU=0.5

# Comma-separated class names to treat as threats
THREAT_CLASSES=knife,gun,pistol,rifle,weapon,person

# Only run inference every Nth frame during IDLE (saves CPU)
IDLE_INFERENCE_INTERVAL=5

# Image size fed to YOLO (must be multiple of 32)
YOLO_IMGSZ=640

# ── Alerting & Notifications ──────────────────────────────────────────────────
# HTTP webhook endpoint; leave blank to disable
WEBHOOK_URL=

# Webhook POST timeout in seconds
WEBHOOK_TIMEOUT_S=5.0

# Thumbnail storage directory
THUMBNAIL_DIR=alerts

# Minimum seconds between repeated alerts for the same class
ALERT_COOLDOWN_S=15.0

# Twilio SMS Emergency Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_NUMBERS=

# Emergency Location Name (used in SMS/Email alerts)
LOCATION_NAME=Visadin Guard Post 1

# Email Notifications (SMTP)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── API / Dashboard ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# MJPEG stream quality (1–100)
MJPEG_QUALITY=80

# CORS allowed origins (comma-separated; * = any)
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Optional log file path (leave blank to log to stdout only)
LOG_FILE=
